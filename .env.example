# =============================================================================
# Cortex — Persistent Context Engine
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# xAI Grok — LLM provider for the three llm_layer components
# (LLMWindowSummarizer, LLMReranker, LLMExplainer).
#
# If XAI_API_KEY is unset or blank, every LLM call short-circuits to None and
# each component falls through to its deterministic fallback:
#   - LLMWindowSummarizer.summarize()  -> "" (empty summary, no rerank signal)
#   - LLMReranker.rerank()             -> candidates[:top_k] in LSH order
#   - LLMExplainer.explain()           -> _fallback_explain() template string
# The engine stays correct without a key; it just loses the LLM-quality lift.
# -----------------------------------------------------------------------------

# Required for LLM features. Get one at https://console.x.ai/
XAI_API_KEY=

# Optional — defaults to grok-2-latest. Override to pin a specific Grok model.
# Examples: grok-2-latest, grok-2-1212, grok-beta
XAI_MODEL=grok-2-latest

# Optional — defaults to the xAI public endpoint. Override for a proxy or
# OpenAI-compatible gateway.
XAI_API_URL=https://api.x.ai/v1/chat/completions
