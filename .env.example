# =============================================================================
# Cortex — Persistent Context Engine
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Groq — LLM provider for the three llm_layer components
# (LLMWindowSummarizer, LLMReranker, LLMExplainer).
#
# If GROQ_API_KEY is unset or blank, every LLM call short-circuits to None and
# each component falls through to its deterministic fallback:
#   - LLMWindowSummarizer.summarize()  -> "" (empty summary, no rerank signal)
#   - LLMReranker.rerank()             -> candidates[:top_k] in LSH order
#   - LLMExplainer.explain()           -> _fallback_explain() template string
# The engine stays correct without a key; it just loses the LLM-quality lift.
# -----------------------------------------------------------------------------

# Required for LLM features. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile. Override to pin a specific
# Groq-hosted model. Examples:
#   llama-3.3-70b-versatile    (high quality, recommended)
#   llama-3.1-8b-instant       (fastest, lowest latency)
#   mixtral-8x7b-32768         (long context)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — defaults to the Groq public endpoint. Override for a proxy or
# alternate OpenAI-compatible gateway.
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

